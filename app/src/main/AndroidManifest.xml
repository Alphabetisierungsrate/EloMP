<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.elomp.app">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="23" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity android:name=".ui.MainActivity" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.PlayersActivity" android:label="@string/title_players" />
        <activity android:name=".ui.RankingsActivity" android:label="@string/title_rankings" />
        <activity android:name=".ui.RankingDetailActivity" android:label="@string/title_ranking_detail" />
        <activity android:name=".ui.ResultEntryActivity" android:label="@string/title_result_entry" />
        <activity android:name=".ui.TotalRankingActivity" android:label="@string/title_total_ranking" />

    </application>
</manifest>
